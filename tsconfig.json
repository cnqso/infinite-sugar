{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true
  },
  "include": [
    "web/entry.js",
    "web/app.js",
    "web/brain.js",
    "web/vendor/mujoco_wasm.d.ts"
  ],
  "exclude": ["web/vendor/**/*.js"]
}
