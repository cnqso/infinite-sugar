{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true
  },
  "include": [
    "web/entry.ts",
    "web/app.ts",
    "web/brain.ts",
    "web/neural-map.ts",
    "web/performance.ts",
    "web/vendor/mujoco_wasm.d.ts"
  ],
  "exclude": ["web/vendor/**/*.js"]
}
